{
  "entities": {
    "SavedPlace": {
      "title": "SavedPlace",
      "description": "A place or marker saved on the interactive map",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
        "name": {
          "type": "string",
          "description": "Name of the place or marker",
          "maxLength": 100
        },
        "city": {
          "type": "string",
          "description": "City name",
          "maxLength": 100
        },
        "latitude": {
          "type": "number",
          "description": "Latitude coordinate"
        },
        "longitude": {
          "type": "number",
          "description": "Longitude coordinate"
        },
        "layerType": {
          "type": "string",
          "enum": ["satellite", "streets", "radar"],
          "description": "Map view mode"
        },
        "notes": {
          "type": "string",
          "description": "Additional notes or description",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "userId": {
          "type": "string",
          "description": "Creator user ID or guest identifier",
          "maxLength": 128
        }
      },
      "required": ["name", "city", "latitude", "longitude", "createdAt"]
    },
    "WorkOrder": {
      "title": "WorkOrder",
      "description": "Field operation work order for crystal chandelier installation and delivery",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
        "orderNumber": {
          "type": "string",
          "description": "Unique order code"
        },
        "status": {
          "type": "string",
          "description": "Work order state"
        },
        "customerNameAr": {
          "type": "string",
          "description": "Customer name in Arabic"
        },
        "customerPhone": {
          "type": "string",
          "description": "Contact phone"
        },
        "customerLocationConfirmed": {
          "type": "boolean",
          "description": "True if customer confirmed GPS location via WhatsApp link"
        }
      },
      "required": ["id", "orderNumber", "status"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Crystal transport truck with live GPS telemetry, driver diligence, and vault security",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Vehicle fleet ID"
        },
        "plateNumber": {
          "type": "string",
          "description": "Vehicle license plate"
        },
        "status": {
          "type": "string",
          "description": "Operational status"
        },
        "currentLat": {
          "type": "number",
          "description": "Real-time latitude"
        },
        "currentLng": {
          "type": "number",
          "description": "Real-time longitude"
        },
        "speedKmH": {
          "type": "number",
          "description": "Current speed"
        },
        "driverDiligenceScore": {
          "type": "number",
          "description": "Driver integrity and diligence score 0-100"
        },
        "driverDiligenceStatus": {
          "type": "string",
          "description": "Current diligence status"
        },
        "cargoLockSecured": {
          "type": "boolean",
          "description": "Whether the crystal cargo vault is locked"
        }
      },
      "required": ["id", "plateNumber", "status"]
    },
    "CustomerLocation": {
      "title": "CustomerLocation",
      "description": "Customer location shared via WhatsApp link directly connected to work order",
      "type": "object",
      "properties": {
        "workOrderId": {
          "type": "string",
          "description": "Associated work order ID"
        },
        "latitude": {
          "type": "number",
          "description": "Customer latitude"
        },
        "longitude": {
          "type": "number",
          "description": "Customer longitude"
        },
        "accuracy": {
          "type": "number",
          "description": "GPS accuracy in meters"
        },
        "addressText": {
          "type": "string",
          "description": "Customer address notes"
        },
        "submittedAt": {
          "type": "string",
          "description": "Submission timestamp"
        }
      },
      "required": ["workOrderId", "latitude", "longitude"]
    }
  },
  "firestore": {
    "/saved_places/{placeId}": {
      "schema": "SavedPlace",
      "description": "Saved places and custom pins on the map"
    },
    "/work_orders/{orderId}": {
      "schema": "WorkOrder",
      "description": "Collection of operational work orders"
    },
    "/vehicles/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Real-time fleet telemetry, GPS positions, and driver diligence"
    },
    "/customer_locations/{locId}": {
      "schema": "CustomerLocation",
      "description": "Direct customer location submissions from WhatsApp link"
    }
  }
}
